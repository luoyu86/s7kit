<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 紧凑: 体重标签+大数字+较昨日 居中, 底部锯齿迷你曲线 (总览板 2×2 412×412) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/widget_card_light"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_label_weight"
        android:textSize="13sp"
        android:textColor="#2A2F2D" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/wWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--.-"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#17211E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginBottom="5dp"
            android:text="kg"
            android:textSize="13sp"
            android:textColor="#7A8A85" />
    </LinearLayout>

    <TextView
        android:id="@+id/wDelta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="暂无称重"
        android:textSize="12.5sp"
        android:textColor="#35B895" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/wSpark"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:scaleType="fitCenter" />
</LinearLayout>
